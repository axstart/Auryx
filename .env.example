# Copy to .env (gitignored) for local dev, or set on the host.
# Production secrets live on Render (API). Frontend-only public vars on Vercel.
# Never commit real keys. DATABASE_URL comes from Supabase (Postgres).

# --- Supabase Postgres (required for API + sessions) ---
DATABASE_URL=
# Optional. Default is unset: TLS stays on, but the API pool does not verify the
# CA (avoids SELF_SIGNED_CERT_IN_CHAIN to Supabase). Set true only when the CA is installed.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Session (required in production on Render) ---
SESSION_SECRET=

# --- Email — Resend preferred (set on Render) ---
RESEND_API_KEY=
RESEND_FROM=Auryx <noreply@auryxlife.com>
RESEND_REPLY_TO=info@auryxlife.com

# Fallback when RESEND_API_KEY is unset
ZOHO_EMAIL=
ZOHO_PASSWORD=

# --- Env-based super-admins (set on Render — never commit real values) ---
ADMIN_LEO_EMAIL=
ADMIN_LEO_PASSWORD=
ADMIN_ROMY_EMAIL=
ADMIN_ROMY_PASSWORD=
# Local/dev only — never set true in production
# ADMIN_MFA_DISABLED=true

# --- Optional: OpenAI-compatible Aria / protocol client (Render) ---
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Optional: payments / SMS (Render) ---
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENTNODE_API_HOST=
# PAYMENTNODE_MERCHANT_ID=
# PAYMENTNODE_MERCHANT_SECRET=
# PAYMENTNODE_PUBLIC_KEY=
# PAYMENTNODE_VAULT_HOST=
# PAYMENTNODE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NOTIFY_PHONE_NUMBER=
# Marketing SMS journeys (welcome / cart_abandon / post_purchase / win_back).
# Off unless explicitly true — uses the existing Twilio account; usage is billed to the client.
# MARKETING_SMS_ENABLED=true

# --- Local Vite / API ports (dev) ---
# PORT=
# BASE_PATH=/

# --- Optional frontend (Vercel / local Vite) ---
# VITE_API_BASE=   # absolute API origin if not using same-origin /api rewrite to Render
# VITE_GSC_VERIFICATION=
